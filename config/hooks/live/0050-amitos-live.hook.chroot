#!/bin/bash
# ============================================================
#  AMIT OS — Live System Boot Setup Hook
#  Configures the autostart script for the live user session
# ============================================================

set -e
echo "[Live] Configuring Live Session Autostart..."

# 1. Create the startup script directory
mkdir -p /usr/local/bin

# 2. Write the actual live session startup script
cat > /usr/local/bin/amitos-live-login << 'EOF'
#!/bin/bash
# Wait for the desktop environment to settle
sleep 3

# Set live session wallpaper
if [ -f /usr/share/amitos/wallpapers/amitos-wallpaper.jpg ]; then
    plasma-apply-wallpaperimage /usr/share/amitos/wallpapers/amitos-wallpaper.jpg 2>/dev/null || true
elif [ -f /usr/share/amitos/branding/wallpaper.png ]; then
    plasma-apply-wallpaperimage /usr/share/amitos/branding/wallpaper.png 2>/dev/null || true
fi

# Welcome notification
notify-send --urgency=normal --icon=amitos-logo \
    'Welcome to Amit OS 🎉' \
    'Fast • Secure • Beautiful\nAmitShield is protecting your system.' 2>/dev/null || true
EOF

chmod +x /usr/local/bin/amitos-live-login

# 3. Create the autostart entry for all users
mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/amitos-live-login.desktop << 'EOF'
[Desktop Entry]
Type=Application
Exec=/usr/local/bin/amitos-live-login
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Amit OS Live Login Setup
Comment=Sets up live user desktop wallpaper and notifications
EOF

echo "✓ Live session autostart configured successfully."
