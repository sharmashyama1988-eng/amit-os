#!/bin/bash
# Installs all custom Amit OS apps into the chroot
# Runs during ISO build (live-build hook)

set -e
echo "[Amit Apps] Installing custom Python apps..."

APPS_SRC="/mnt/d/Amit os/apps"
BIN="/usr/local/bin"
DESK="/usr/share/applications"

# Copy all Python apps
for f in amitcalc.py amitnotes.py amitmonitor.py amitstore.py amitwelcome.py; do
    cp "$APPS_SRC/$f" "$BIN/$f"
    chmod +x "$BIN/$f"
done

# Create wrapper scripts (so they work without 'python3' prefix)
for app in amitcalc amitnotes amitmonitor amitstore amitwelcome; do
    cat > "$BIN/$app" << WRAP
#!/bin/bash
exec python3 $BIN/${app}.py "\$@"
WRAP
    chmod +x "$BIN/$app"
done

# Install Python GTK deps
apt-get install -y python3-gi python3-gi-cairo gir1.2-gtk-3.0 \
    gir1.2-adw-1 libgtk-3-0 2>/dev/null || true

# Desktop entries for custom apps
cat > "$DESK/amitcalc.desktop" << EOF
[Desktop Entry]
Name=AmitCalc
Comment=Scientific Calculator
Exec=$BIN/amitcalc
Icon=accessories-calculator
Terminal=false
Type=Application
Categories=Utility;Calculator;
EOF

cat > "$DESK/amitnotes.desktop" << EOF
[Desktop Entry]
Name=AmitNotes
Comment=Quick Notes and Reminders
Exec=$BIN/amitnotes
Icon=accessories-text-editor
Terminal=false
Type=Application
Categories=Utility;
EOF

cat > "$DESK/amitmonitor.desktop" << EOF
[Desktop Entry]
Name=AmitMonitor
Comment=System Resource Monitor
Exec=$BIN/amitmonitor
Icon=utilities-system-monitor
Terminal=false
Type=Application
Categories=System;Monitor;
EOF

cat > "$DESK/amitstore.desktop" << EOF
[Desktop Entry]
Name=AmitStore
Comment=Install and manage applications
Exec=$BIN/amitstore
Icon=system-software-install
Terminal=false
Type=Application
Categories=System;
EOF

cat > "$DESK/amitwelcome.desktop" << EOF
[Desktop Entry]
Name=Welcome to Amit OS
Comment=Getting started with Amit OS
Exec=$BIN/amitwelcome
Icon=help-about
Terminal=false
Type=Application
Categories=System;
X-GNOME-Autostart-enabled=true
EOF

# Autostart welcome on first login
mkdir -p /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/amitwelcome.desktop << EOF
[Desktop Entry]
Name=Welcome to Amit OS
Exec=$BIN/amitwelcome
Type=Application
X-GNOME-Autostart-enabled=true
EOF

echo "[Amit Apps] All apps installed!"
