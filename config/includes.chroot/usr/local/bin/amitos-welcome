#!/bin/bash
# =============================================================================
#  amitos-welcome — AmitOS Welcome App Launcher
#  Location : /usr/local/bin/amitos-welcome
#  Run as   : regular user (desktop session)
# =============================================================================

# ── Colours (used in terminal fallback) ──────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Paths & constants ─────────────────────────────────────────────────────────
WELCOME_APP_DIRS=(
    "/usr/lib/amitos-welcome"
    "/usr/share/amitos-welcome"
    "/opt/amitos-welcome"
    "/usr/local/share/amitos-welcome"
)

WELCOME_BINARIES=(
    "amitos-welcome-app"
    "amitos_welcome"
    "welcome-amitos"
)

PYTHON_SCRIPTS=(
    "welcome.py"
    "main.py"
    "app.py"
)

# ── Helpers ───────────────────────────────────────────────────────────────────
log_info()  { echo -e "${GREEN}✔  $*${RESET}"; }
log_warn()  { echo -e "${YELLOW}⚠  $*${RESET}"; }
log_error() { echo -e "${RED}✘  $*${RESET}"; }

# Ensure DISPLAY / Wayland are available
check_display() {
    if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
        log_warn "No graphical display detected — falling back to terminal mode."
        return 1
    fi
    return 0
}

# Try to launch a GTK/Qt welcome app binary from known paths
try_binary() {
    for bin in "${WELCOME_BINARIES[@]}"; do
        if command -v "$bin" &>/dev/null; then
            log_info "Launching ${bin} …"
            exec "$bin" "$@"
        fi
    done

    for dir in "${WELCOME_APP_DIRS[@]}"; do
        for bin in "${WELCOME_BINARIES[@]}"; do
            if [[ -x "${dir}/${bin}" ]]; then
                log_info "Launching ${dir}/${bin} …"
                exec "${dir}/${bin}" "$@"
            fi
        done
    done

    return 1
}

# Try to launch a Python-based welcome app
try_python_app() {
    local python_cmd=""
    command -v python3 &>/dev/null && python_cmd="python3"
    command -v python  &>/dev/null && python_cmd="${python_cmd:-python}"

    [[ -z "$python_cmd" ]] && return 1

    for dir in "${WELCOME_APP_DIRS[@]}"; do
        for script in "${PYTHON_SCRIPTS[@]}"; do
            if [[ -f "${dir}/${script}" ]]; then
                log_info "Launching Python welcome app: ${dir}/${script}"
                exec "$python_cmd" "${dir}/${script}" "$@"
            fi
        done
    done

    return 1
}

# Try launching via .desktop file
try_desktop_file() {
    local desktop_file=""
    for d in /usr/share/applications /usr/local/share/applications; do
        if [[ -f "${d}/amitos-welcome.desktop" ]]; then
            desktop_file="${d}/amitos-welcome.desktop"
            break
        fi
    done

    [[ -z "$desktop_file" ]] && return 1

    if command -v gtk-launch &>/dev/null; then
        log_info "Launching via gtk-launch …"
        exec gtk-launch amitos-welcome
    elif command -v xdg-open &>/dev/null; then
        log_info "Launching via xdg-open …"
        exec xdg-open "$desktop_file"
    fi

    return 1
}

# Terminal fallback: show welcome message inline
terminal_welcome() {
    clear
    echo ""
    echo -e "  ${CYAN}${BOLD}╔══════════════════════════════════════════════════╗${RESET}"
    echo -e "  ${CYAN}${BOLD}║              Welcome to  A m i t O S             ║${RESET}"
    echo -e "  ${CYAN}${BOLD}╚══════════════════════════════════════════════════╝${RESET}"
    echo ""

    # OS version
    if [[ -f /etc/amitos-release ]]; then
        VER=$(cat /etc/amitos-release)
    else
        VER=$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-AmitOS}")
    fi

    echo -e "  ${BOLD}Version :${RESET}  ${VER}"
    echo -e "  ${BOLD}Kernel  :${RESET}  $(uname -r)"
    echo -e "  ${BOLD}User    :${RESET}  ${USER:-$(whoami)}"
    echo -e "  ${BOLD}Date    :${RESET}  $(date '+%A, %d %B %Y  %H:%M')"
    echo ""
    echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
    echo ""
    echo -e "  ${BOLD}Quick commands:${RESET}"
    echo -e "    ${GREEN}amitos-info${RESET}    — View system information"
    echo -e "    ${GREEN}amitos-update${RESET}  — Update your system"
    echo -e "    ${GREEN}amitos-repair${RESET}  — Fix common issues"
    echo ""
    echo -e "  ${CYAN}────────────────────────────────────────────────────${RESET}"
    echo ""
    echo -e "  ${YELLOW}Tip:${RESET} Run '${BOLD}amitos-info${RESET}' to see your system details."
    echo ""
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    # 1. Try graphical launchers (only if display is present)
    if check_display; then
        try_binary        "$@" 2>/dev/null && exit 0
        try_python_app    "$@" 2>/dev/null && exit 0
        try_desktop_file       2>/dev/null && exit 0
    fi

    # 2. Fallback: terminal welcome screen
    terminal_welcome
}

main "$@"
