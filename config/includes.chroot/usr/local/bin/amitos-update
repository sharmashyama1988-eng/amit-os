#!/bin/bash
# =============================================================================
#  amitos-update — AmitOS System Updater
#  Location : /usr/local/bin/amitos-update
#  Run as   : root (or via sudo)
# =============================================================================

set -euo pipefail

# ── Colours ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Helpers ───────────────────────────────────────────────────────────────────
print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ╔═══════════════════════════════════════╗"
    echo "  ║         AmitOS System Updater         ║"
    echo "  ╚═══════════════════════════════════════╝"
    echo -e "${RESET}"
}

step() {
    echo -e "\n${BLUE}${BOLD}▶  $1${RESET}"
}

ok() {
    echo -e "${GREEN}✔  $1${RESET}"
}

warn() {
    echo -e "${YELLOW}⚠  $1${RESET}"
}

fail() {
    echo -e "${RED}✘  $1${RESET}"
}

separator() {
    echo -e "${CYAN}────────────────────────────────────────────${RESET}"
}

require_root() {
    if [[ $EUID -ne 0 ]]; then
        fail "This script must be run as root.  Try: sudo amitos-update"
        exit 1
    fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
main() {
    print_banner
    require_root

    separator
    echo -e " ${BOLD}Started :${RESET} $(date '+%Y-%m-%d %H:%M:%S')"
    separator

    # 1. Update package lists
    step "Updating package lists …"
    if apt-get update -q 2>&1 | grep -E "^(Err|W:)" | while read -r line; do warn "$line"; done; then
        ok "Package lists updated."
    fi

    # 2. Upgrade installed packages
    step "Upgrading installed packages …"
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
        -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" \
        && ok "All packages upgraded." \
        || { fail "Package upgrade encountered errors."; }

    # 3. Full upgrade (handles dependency changes)
    step "Running full-upgrade …"
    DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y \
        -o Dpkg::Options::="--force-confdef" \
        -o Dpkg::Options::="--force-confold" \
        && ok "Full upgrade complete." \
        || warn "Full upgrade had warnings — check logs."

    # 4. Remove orphaned packages
    step "Removing unused packages …"
    apt-get autoremove -y --purge && ok "Orphaned packages removed."

    # 5. Clean apt cache
    step "Cleaning package cache …"
    apt-get autoclean -y && ok "Cache cleaned."

    # 6. Check critical systemd services
    step "Checking critical systemd services …"
    CRITICAL_SERVICES=(NetworkManager ssh)
    for svc in "${CRITICAL_SERVICES[@]}"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            ok "Service '${svc}' is active."
        else
            warn "Service '${svc}' is NOT active — attempting start …"
            systemctl start "$svc" 2>/dev/null && ok "Service '${svc}' started." \
                || fail "Could not start '${svc}'. Check: journalctl -u ${svc}"
        fi
    done

    # 7. Restart AmitShield
    step "Restarting AmitShield …"
    if systemctl list-units --all --type=service 2>/dev/null | grep -q "amitshield"; then
        systemctl restart amitshield \
            && ok "AmitShield restarted successfully." \
            || warn "AmitShield restart failed — it may need manual attention."
    else
        warn "AmitShield service not found — skipping restart."
    fi

    separator
    echo -e " ${GREEN}${BOLD}Update complete!${RESET}  $(date '+%Y-%m-%d %H:%M:%S')"
    separator
    echo ""
}

main "$@"
